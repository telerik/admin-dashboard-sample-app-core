<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdminDashboard</title>
    <link rel="shortcut icon" href="@Url.Content("~/favicon.ico")" />
    
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400&display=swap" rel="stylesheet">

    @* Add the Kendo UI styles: *@
    @{
        var fontIconsUrl = "https://unpkg.com/@progress/kendo-font-icons/dist/index.css";
    }

    <link rel="stylesheet" href="@fontIconsUrl" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-default@14.6.1/dist/default-main.css" integrity="sha256-UD89BMF5InfiIlo2ZfbShV/zOsHBSxalwEKjWakrpqo=" crossorigin="anonymous" />
    <link rel="stylesheet" href="./css/site.css" />

    @* Add the Kendo UI scripts: *@
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@2026.3.1015/umd/kendo.all.min.js" integrity="sha256-e9W9Kscg9GPWuWSgI3uOxAWsq0R0CqlowtEQuwmsKG8=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@2026.3.1015/umd/kendo.aspnetmvc.min.js" integrity="sha256-vyGK1w64H2GlT+oueup7Q67n5GEEbeuz9p1OI0jLmOI=" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/jszip/dist/jszip.min.js"></script>
    @Html.Kendo().ActivateKendoScripts()
</head>
<body>
    @RenderBody()
</body>
</html>
